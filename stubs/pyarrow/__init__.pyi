from __future__ import annotations

from typing import Any, Iterable, Iterator, Literal, Mapping, Sequence, Type, TypeVar

from .compute import CastOptions

class DataType:
    @property
    def num_fields(self) -> int: ...
    def field(self, i: int) -> "Field": ...

class Date32Type(DataType): ...
class Date64Type(DataType): ...

class TimestampType(DataType):
    @property
    def unit(self) -> str: ...
    @property
    def tz(self) -> str | None: ...

class Time64Type(DataType):
    @property
    def unit(self) -> str: ...

class DurationType(DataType):
    @property
    def unit(self) -> str: ...

class RunEndEncodedType(DataType):
    @property
    def run_end_type(self) -> DataType: ...
    @property
    def value_type(self) -> DataType: ...

class UnionType(DataType):
    @property
    def mode(self) -> str: ...
    @property
    def type_codes(self) -> list[int]: ...

class ListType(DataType):
    @property
    def value_field(self) -> "Field": ...

class FixedSizeListType(ListType):
    @property
    def list_size(self) -> int: ...

class MapType(DataType):
    @property
    def key_field(self) -> "Field": ...
    @property
    def item_field(self) -> "Field": ...
    @property
    def keys_sorted(self) -> bool: ...

class DictionaryType(DataType):
    @property
    def value_type(self) -> DataType: ...
    @property
    def index_type(self) -> DataType: ...
    @property
    def ordered(self) -> bool: ...

class BaseExtensionType(DataType):
    @property
    def storage_type(self) -> DataType: ...
    @property
    def extension_name(self) -> str: ...

class OpaqueType(BaseExtensionType):
    @property
    def type_name(self) -> str: ...
    @property
    def vendor_name(self) -> str: ...

class ExtensionType(BaseExtensionType):
    def __init__(self, storage_type: DataType, extension_name: str) -> None: ...
    def __arrow_ext_serialize__(self) -> bytes: ...
    @classmethod
    def __arrow_ext_deserialize__(
        cls, storage_type: DataType, serialized: bytes
    ) -> "ExtensionType": ...
    def __arrow_ext_scalar_class__(self) -> Type["ExtensionScalar"]: ...

def string() -> DataType: ...
def null() -> DataType: ...
def bool_() -> DataType: ...
def int8() -> DataType: ...
def int16() -> DataType: ...
def int32() -> DataType: ...
def int64() -> DataType: ...
def uint8() -> DataType: ...
def uint16() -> DataType: ...
def uint32() -> DataType: ...
def uint64() -> DataType: ...
def float16() -> DataType: ...
def float32() -> DataType: ...
def float64() -> DataType: ...
def date32() -> DataType: ...
def date64() -> DataType: ...
def binary(length: int = -1) -> DataType: ...
def large_binary() -> DataType: ...
def large_string() -> DataType: ...
def binary_view() -> DataType: ...
def list_(value_type: DataType | Field, list_size: int = -1) -> DataType: ...
def large_list(value_type: DataType | Field) -> DataType: ...
def map_(
    key_type: DataType | Field, item_type: DataType | Field, keys_sorted: bool = False
) -> DataType: ...
def struct(fields: Iterable[Any]) -> DataType: ...
def list_view(value_type: DataType | Field) -> DataType: ...
def dictionary(
    index_type: DataType, value_type: DataType, ordered: bool = False
) -> DataType: ...
def run_end_encoded(run_end_type: DataType, value_type: DataType) -> DataType: ...
def union(
    child_fields: Iterable[Field], mode: str, type_codes: list[int] | None = None
) -> DataType: ...
def field(
    name: str,
    type: DataType,  # noqa: A002
    nullable: bool = True,
    metadata: Mapping | None = None,
) -> Field: ...
def schema(fields: Iterable[Field], metadata: Mapping | None = None) -> Schema: ...

# canonical extension types
def uuid() -> DataType: ...
def bool8() -> DataType: ...
def opaque(storage_type: DataType, type_name: str, vendor_name: str) -> OpaqueType: ...
def month_day_nano_interval() -> DataType: ...
def time32(unit: Literal["s", "ms", "us", "ns"]) -> DataType: ...
def time64(unit: Literal["s", "ms", "us", "ns"]) -> DataType: ...
def timestamp(
    unit: Literal["s", "ms", "us", "ns"], tz: str | None = None
) -> DataType: ...
def duration(unit: Literal["s", "ms", "us", "ns"]) -> DataType: ...

class MemoryPool: ...

class Schema:
    @property
    def metadata(self) -> dict[bytes, bytes] | None: ...
    @property
    def types(self) -> list[DataType]: ...
    def __iter__(self) -> Iterator["Field"]: ...
    def __len__(self) -> int: ...
    def field(self, i: int | str) -> "Field": ...

class Field:
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> DataType: ...  # noqa: A003
    @property
    def nullable(self) -> bool: ...
    @property
    def metadata(self) -> dict[bytes, bytes] | None: ...
    def with_type(self, new_type: DataType) -> "Field": ...

class NativeFile: ...
class MonthDayNano: ...

class Scalar:
    def as_py(self) -> Any: ...
    @property
    def type(self) -> DataType: ...
    @property
    def is_valid(self) -> bool: ...

class ListScalar(Scalar):
    @property
    def values(self) -> Array | None: ...

class StructScalar(Scalar):
    def __getitem__(self, key: int | str) -> Scalar: ...

class UnionScalar(Scalar):
    @property
    def value(self) -> Scalar: ...

class RunEndEncodedScalar(Scalar):
    @property
    def value(self) -> Scalar: ...

class DictionaryScalar(Scalar):
    @property
    def value(self) -> Scalar: ...

class ExtensionScalar(Scalar):
    @property
    def value(self) -> Scalar | None: ...

A = TypeVar("A", bound="_PandasConvertible")

class _PandasConvertible:
    @property
    def type(self) -> DataType: ...  # noqa: A003
    def __len__(self) -> int: ...
    def slice(self: A, offset: int = 0, length: int | None = None) -> A: ...  # noqa: A003
    def cast(
        self: A,
        target_type: DataType | None = None,
        safe: bool = True,
        options: CastOptions | None = None,
    ) -> A: ...
    def __getitem__(self, index: int) -> Scalar: ...
    def __iter__(self) -> Any: ...
    def to_pylist(self) -> list[Any]: ...
    def fill_null(self: A, fill_value: Any) -> A: ...
    def filter(self: A, mask: Any) -> A: ...
    def drop_null(self: A) -> A: ...

class Buffer:
    @property
    def size(self) -> int: ...
    def slice(  # noqa: A003
        self, offset: int = 0, length: int | None = None
    ) -> "Buffer": ...
    def to_pybytes(self) -> bytes: ...

class Array(_PandasConvertible):
    def buffers(self) -> list[Buffer | None]: ...
    def dictionary_encode(self) -> "Array": ...
    def is_valid(self) -> "Array": ...

class ExtensionArray(Array):
    @staticmethod
    def from_storage(typ: DataType, storage: Array) -> "ExtensionArray": ...
    @property
    def storage(self) -> Array: ...

class UnionArray(Array):
    @staticmethod
    def from_sparse(
        types: Array, children: list[Array], field_names: list[str] | None = None
    ) -> UnionArray: ...
    @staticmethod
    def from_dense(
        types: Array,
        value_offsets: Array,
        children: list[Array],
        field_names: list[str] | None = None,
    ) -> UnionArray: ...

class DictionaryArray(Array):
    @staticmethod
    def from_arrays(
        indices: Array, dictionary: Array, ordered: bool = False
    ) -> DictionaryArray: ...
    @property
    def indices(self) -> Array: ...
    @property
    def dictionary(self) -> Array: ...

class RunEndEncodedArray(Array):
    @staticmethod
    def from_arrays(run_ends: Array, values: Array) -> RunEndEncodedArray: ...

class ChunkedArray(_PandasConvertible):
    @property
    def chunks(self) -> list[Array]: ...

class StructArray(Array):
    def flatten(self, memory_pool: MemoryPool | None = None) -> list[Array]: ...
    def field(self, index: int | str) -> Array: ...

T = TypeVar("T", bound="_Tabular")

class _Tabular:
    @classmethod
    def from_arrays(
        cls: Type[T],
        arrays: list[_PandasConvertible],
        names: list[str] | None = None,
        schema: Schema | None = None,
        metadata: Mapping | None = None,
    ) -> T: ...
    @classmethod
    def from_pydict(
        cls: Type[T],
        mapping: Mapping,
        schema: Schema | None = None,
        metadata: Mapping | None = None,
    ) -> T: ...
    def __getitem__(self, index: int) -> _PandasConvertible: ...
    def __len__(self) -> int: ...
    @property
    def column_names(self) -> list[str]: ...
    @property
    def columns(self) -> list[_PandasConvertible]: ...
    @property
    def num_rows(self) -> int: ...
    @property
    def num_columns(self) -> int: ...
    @property
    def schema(self) -> Schema: ...
    def append_column(
        self: T, field_: str | Field, column: Array | ChunkedArray
    ) -> T: ...
    def column(self, i: int | str) -> _PandasConvertible: ...
    def equals(self: T, other: T, check_metadata: bool = False) -> bool: ...
    def itercolumns(self) -> Iterator[_PandasConvertible]: ...
    def rename_columns(self: T, names: list[str]) -> T: ...
    def select(self: T, columns: Sequence[str | int]) -> T: ...
    def set_column(
        self: T, i: int, field_: str | Field, column: Array | ChunkedArray
    ) -> T: ...
    def slice(  # noqa: A003
        self: T,
        offset: int = 0,
        length: int | None = None,
    ) -> T: ...
    def sort_by(
        self: T,
        sorting: str | list[tuple[str, Literal["ascending", "descending"]]],
        **kwargs: Any,
    ) -> T: ...
    def to_pylist(self) -> list[dict[str, Any]]: ...
    def cast(self: T, target_schema: Schema) -> T: ...  # noqa: A003

class RecordBatch(_Tabular): ...

class Table(_Tabular):
    @classmethod
    def from_batches(
        cls,
        batches: Iterable[RecordBatch],
        schema: Schema | None = None,
    ) -> "Table": ...
    @classmethod
    def from_pandas(
        cls,
        # a pandas DataFrame, typed as Any so that these stubs don't drag
        # pandas-stubs into the static analysis environment
        df: Any,
        schema: Schema | None = None,
        preserve_index: bool | None = None,
        nthreads: int | None = None,
        columns: list[str] | None = None,
        safe: bool = True,
    ) -> "Table": ...
    def to_batches(self) -> list[RecordBatch]: ...
    # a pandas DataFrame, typed as Any for the reason `from_pandas` is
    def to_pandas(self) -> Any: ...

def scalar(value: Any, type: DataType) -> Scalar: ...  # noqa: A002
def array(
    obj: Iterable,
    type: DataType | None = None,  # noqa: A002
    mask: Array | None = None,
    size: int | None = None,
    from_pandas: bool | None = None,
    safe: bool = True,
    memory_pool: MemoryPool | None = None,
) -> Array | ChunkedArray: ...
def chunked_array(
    arrays: Iterable[Array],
    type: DataType | None = None,  # noqa: A002
) -> ChunkedArray: ...
def concat_arrays(
    arrays: Iterable[Array], memory_pool: MemoryPool | None = None
) -> Array: ...
def nulls(
    size: int,
    type: DataType | None = None,  # noqa: A002
    memory_pool: MemoryPool | None = None,
) -> Array: ...
def table(
    # `data` also accepts a pandas DataFrame, typed here as Any so that these
    # stubs don't drag pandas-stubs into the static analysis environment
    data: Any | Mapping[str, _PandasConvertible | list] | list[_PandasConvertible],
    names: list[str] | None = None,
    schema: Schema | None = None,
    metadata: Mapping | None = None,
    nthreads: int | None = None,
) -> Table: ...
def set_timezone_db_path(path: str) -> None: ...
